# The Zig build cache. `native/prebuilt/` is the output and *is* committed —
# the binaries ship in the package, so they are checked in rather than built
# on anyone's machine.
native/.zig-cache
.vscode
.DS_Store
.eslintcache
tsconfig.tsbuildinfo
*.log*
*.env*

# pjdfstest: the suite is cloned and built on demand (test/pjdfstest/run.sh),
# pinned to a commit there. Only the analysis is committed.
test/pjdfstest/pjdfstest
test/pjdfstest/results.txt
test/pjdfstest/results.json
test/pjdfstest/mnt
