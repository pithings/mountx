node_modules
coverage
dist

# The Zig build cache and its output. Neither is committed and neither ships:
# what git and the package carry is `native/prebuilt.mjs`, the same bytes as
# base64, generated from these by `native/build.ts`. One committed copy of a
# binary is enough, and the one that survives bundling is the useful one.
native/.zig-cache
native/prebuilt/
.vscode
.DS_Store
.eslintcache
tsconfig.tsbuildinfo
*.log*
*.env*

# `pnpm bench:bun` writes one of these per run, next to the summary it prints.
# It is a recording of one machine on one afternoon, and it is a third of a
# megabyte; what is worth keeping from a profiling run is the conclusion.
*.cpuprofile

# pjdfstest: the suite is cloned and built on demand (test/pjdfstest/run.sh),
# pinned to a commit there. Only the analysis is committed.
test/pjdfstest/pjdfstest
test/pjdfstest/results.txt
test/pjdfstest/results.json
test/pjdfstest/mnt
